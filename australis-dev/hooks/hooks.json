{
  "description": "Australis dev — tells the session which level this machine is set to",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/nivel.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
